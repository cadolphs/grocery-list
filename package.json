{
  "name": "grocery-list",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.mjs --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:siblings": "node scripts/check-domain-test-siblings.mjs",
    "check:map": "node scripts/control.mjs map --check",
    "check:dead": "knip --no-progress",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run check:siblings && npm run check:map && npm run check:dead && npm run test:scripts && jest --ci --coverage --bail",
    "control": "node --env-file-if-exists=.env scripts/control.mjs",
    "board": "npx --yes github:cadolphs/cad-skills board",
    "postinstall": "simple-git-hooks"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~58.0.25",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "firebase": "^12.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@react-native/jest-preset": "^0.88.1",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/jest-runner": "^9.6.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "^25.9.9",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "knip": "^6.42.1",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.3.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.57.1"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 15000,
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/web/",
      "/scripts/"
    ]
  },
  "private": true,
  "simple-git-hooks": {
    "pre-commit": "npm run lint && npm run format:check",
    "pre-push": "npm run typecheck && npm run check:map && npm run check:dead"
  }
}
