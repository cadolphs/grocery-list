{
  "name": "grocery-list",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:siblings": "node scripts/check-domain-test-siblings.mjs",
    "check:map": "node scripts/control.mjs map --check",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run check:siblings && npm run check:map && jest --ci --coverage --bail",
    "control": "node --env-file-if-exists=.env scripts/control.mjs",
    "postinstall": "simple-git-hooks"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~56.0.24",
    "expo-status-bar": "~56.0.4",
    "firebase": "^12.8.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/jest-runner": "^9.6.0",
    "@stryker-mutator/typescript-checker": "^9.6.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.6",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.57.1"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 15000,
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/web/"
    ]
  },
  "private": true,
  "simple-git-hooks": {
    "pre-commit": "npm run lint && npm run format:check",
    "pre-push": "npm run typecheck && npm run check:map"
  }
}
