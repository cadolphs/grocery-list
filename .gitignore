# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Claude Code local settings
.claude/settings.local.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Stryker mutation testing
.stryker-tmp/
reports/

# nWave is retired here (ADR-012); a globally installed plugin may still write this
.nwave/

# Firebase local cache & logs
.firebase/
firebase-debug.log
# Claude Code per-session scheduler lock (machine-local, never shared)
.claude/scheduled_tasks.lock

# control CLI state (sessions, dev log, screenshots, videos)
.control/

# jest --coverage output (npm run verify)
coverage/
